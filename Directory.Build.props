<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Company>PCleaner</Company>
    <Product>PCleaner</Product>
    <Authors>PCleaner</Authors>
    <Copyright>Copyright © 2026</Copyright>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CA1031: catching general exceptions is intentional in a cleaner that must never crash while deleting files. -->
    <!-- CA1848/CA2254: we use a lightweight custom logger, not Microsoft.Extensions.Logging. -->
    <!-- CA1707: test method names use underscores by convention. -->
    <NoWarn>$(NoWarn);CA1031;CA1848;CA2254;CA1707</NoWarn>
  </PropertyGroup>

</Project>