<Window x:Class="PCleaner.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCleaner"
        Width="560" SizeToContent="Height" MinHeight="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource Font.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed">
    <!-- The drop shadow lives on a childless twin behind the panel, so the text is drawn directly on the window
         surface instead of being rasterised through the effect. -->
    <Grid Margin="24">
        <Border CornerRadius="{StaticResource Radius.Hero}" Background="{StaticResource Brush.SurfaceRaised}" Effect="{StaticResource Shadow.Dialog}" />
        <Border CornerRadius="{StaticResource Radius.Hero}" Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" MouseLeftButtonDown="OnDragMove">
        <Border Padding="26,24,26,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Icon + text rows are Grids, not horizontal StackPanels: a StackPanel would hand the text unlimited
                     width and the panel would clip it; the star column wraps text to the space that really exists. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="{StaticResource Radius.Card}" Background="{StaticResource Brush.AccentSoft}" BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1" VerticalAlignment="Top">
                        <TextBlock x:Name="IconGlyph" Text="&#xE74D;" Style="{StaticResource Text.Icon}" FontSize="18" Foreground="{StaticResource Brush.Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}" TextWrapping="Wrap" />
                        <TextBlock x:Name="MessageText" Style="{StaticResource Text.Subtitle}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,5,0,0" LineHeight="19" />
                    </StackPanel>
                </Grid>

                <Border x:Name="WarningPanel" Grid.Row="1" Margin="0,18,0,0" CornerRadius="{StaticResource Radius.Row}" Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.WarningBorder}" BorderThickness="1" Padding="14,11" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock x:Name="WarningText" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warning}" LineHeight="18" />
                    </Grid>
                </Border>

                <Grid x:Name="DetailPanel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA18;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Top" Margin="2,2,10,0" />
                    <TextBlock x:Name="DetailText" Grid.Column="1" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" LineHeight="18" />
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="100" Margin="0,0,10,0" Click="OnCancel" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" MinWidth="130" IsDefault="False" Click="OnConfirm">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="#06121F" Margin="0,0,8,0" />
                            <TextBlock x:Name="ConfirmText" Text="Clean now" Foreground="#06121F" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        </Border>
    </Grid>
</Window>